library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

-- Тестбенч для i2c_master
-- Містить генератор тактового сигналу та скидання, подає стимул для передавача (Tx)
-- і містить простий емулятор slave для перевірки приймача (Rx).

entity tb_i2c_master is
end entity;

architecture sim of tb_i2c_master is
  -- Сигнали тестбенча
  signal clk    : std_logic := '0';
  signal rst_n  : std_logic := '0';

  -- Сигнали для DUT
  signal start   : std_logic := '0';
  signal addr    : std_logic_vector(6 downto 0) := (others => '0');
  signal rw      : std_logic := '0';
  signal data_in : std_logic_vector(7 downto 0) := (others => '0');
  signal data_out: std_logic_vector(7 downto 0);
  signal busy    : std_logic;

  -- Лінії I2C, які з'єднують TB та DUT
  signal sda_tb : std_logic := 'Z';
  signal scl    : std_logic;

  -- Параметри тесту
  constant CLK_PERIOD_NS : time := 20 ns; -- 50 MHz

  -- Сигнали простого slave-емулятора
  signal slave_active : std_logic := '0';
  signal slave_byte   : std_logic_vector(7 downto 0) := x"A5"; -- байт, який відправляє slave при читанні
  signal slave_bit_idx: integer range 0 to 7 := 7;
  signal tb_done      : std_logic := '0';

begin
  ------------------------------------------------------------------
  -- Інстанціювання DUT
  ------------------------------------------------------------------
  UUT: entity work.i2c_master
    generic map (PRESCALER => 50) -- зменшений прескалер для швидшої імітації
    port map (
      clk => clk,
      rst_n => rst_n,
      start => start,
      addr => addr,
      rw => rw,
      data_in => data_in,
      data_out => data_out,
      busy => busy,
      sda => sda_tb,
      scl => scl
    );

  ------------------------------------------------------------------
  -- Генератор тактового сигналу
  ------------------------------------------------------------------
  clk_gen: process
  begin
    while now < 200 ms loop
      clk <= '0';
      wait for CLK_PERIOD_NS/2;
      clk <= '1';
      wait for CLK_PERIOD_NS/2;
    end loop;
    wait;
  end process;

  ------------------------------------------------------------------
  -- Стимул: скидання, запис, потім читання
  ------------------------------------------------------------------
  stim_proc: process
  begin
    -- Скидання DUT
    rst_n <= '0';
    wait for 200 ns;
    rst_n <= '1';
    wait for 200 ns;

    -- Тест 1: запис одного байта
    addr <= "0101010";
    rw <= '0'; -- запис
    data_in <= x"5A";
    wait for CLK_PERIOD_NS;
    start <= '1';
    wait for CLK_PERIOD_NS;
    start <= '0';

    -- Дочекатися завершення операції
    wait until busy = '1';
    wait until busy = '0';
    report "Запис завершено, переходжу до тесту читання";
    wait for 1 us;

    -- Тест 2: читання одного байта
    addr <= "0101010";
    rw <= '1'; -- читання
    data_in <= (others => '0');

    -- Підготувати slave-емулятор для відправки байта
    slave_byte <= x"A5";
    wait for 200 ns;
    slave_active <= '1';

    wait for CLK_PERIOD_NS;
    start <= '1';
    wait for CLK_PERIOD_NS;
    start <= '0';

    -- Дочекатися завершення операції читання
    wait until busy = '1';
    wait until busy = '0';
    wait for 500 ns; -- невелика пауза для стабілізації сигналів

    report "Читання завершено, перевірте data_out у осцилограмах";
    tb_done <= '1';

    wait;
  end process;

  ------------------------------------------------------------------
  -- Простий slave-емулятор для подачі бітів під час читання
  ------------------------------------------------------------------
  slave_proc: process
  begin
    wait until slave_active = '1';

    -- Індекс біта починаємо з 7 (MSB)
    slave_bit_idx <= 7;

    -- Синхронізуємося з SCL: подавати біт на SCL низький (перед підйомом)
    wait until scl = '0';
    wait for 1 ns;

    while slave_active = '1' loop
      wait until scl = '0';
      -- Виставити біт на SDA перед підйомом SCL
      sda_tb <= slave_byte(slave_bit_idx);
      wait until scl = '1'; -- біт читається master'ом на підйомі SCL

      if slave_bit_idx = 0 then
        -- Відправлено останній біт
        slave_active <= '0';
        sda_tb <= 'Z'; -- відпускаємо лінію
        exit;
      else
        slave_bit_idx <= slave_bit_idx - 1;
        wait until scl = '0';
      end if;
    end loop;

    wait;
  end process;

  ------------------------------------------------------------------
  -- Процедура завершення тесту
  ------------------------------------------------------------------
  finish_proc: process
  begin
    wait until tb_done = '1';
    wait for 1 us;
    report "Тестбенч завершено";
    wait;
  end process;

end architecture;
