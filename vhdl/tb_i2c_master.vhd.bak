library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

-- ???????? ??? i2c_master
-- (????????? ? ?????? 130-132)

entity tb_i2c_master is
end entity;

architecture sim of tb_i2c_master is
  -- ??????? ?? ?????????? ???????
  signal clk    : std_logic := '0'; [cite: 133]
  signal rst_n  : std_logic := '0'; [cite: 134]

  -- ????????? ?? DUT
  signal start   : std_logic := '0'; [cite: 134]
  signal addr    : std_logic_vector(6 downto 0) := (others => '0'); [cite: 135]
  signal rw      : std_logic := '0'; [cite: 136]
  signal data_in : std_logic_vector(7 downto 0) := (others => '0'); [cite: 137]
  signal data_out: std_logic_vector(7 downto 0); [cite: 137]
  signal busy    : std_logic; [cite: 138]

  -- ??????? ????? I2C
  signal sda_tb : std_logic := 'Z'; [cite: 138]
  signal scl    : std_logic; [cite: 139]

  -- ????????? ?????????
  constant CLK_PERIOD_NS : time := 20 ns; [cite: 140] -- 50 MHz

  -- ??????? ??? ???????? slave-?????????
  signal slave_active : std_logic := '0'; [cite: 141]
  signal slave_byte   : std_logic_vector(7 downto 0) := x"A5"; [cite: 142]
  signal slave_bit_idx: integer range 0 to 7 := 7; [cite: 143]
  signal tb_done      : std_logic := '0'; [cite: 144]

begin
  ------------------------------------------------------------------
  -- ????????? DUT
  ------------------------------------------------------------------
  UUT: entity work.i2c_master
    generic map (PRESCALER => 50) -- ???????? ??? ??????? ????????? [cite: 145]
    port map (
      clk => clk,
      rst_n => rst_n,
      start => start,
      addr => addr,
      rw => rw,
      data_in => data_in,
      data_out => data_out,
      busy => busy,
      sda => sda_tb, [cite: 146]
      scl => scl
    ); [cite: 146]

  ------------------------------------------------------------------
  -- ???????? ?????????
  ------------------------------------------------------------------
  clk_gen: process
  begin
    while now < 200 ms loop
      clk <= '0';
      wait for CLK_PERIOD_NS/2; [cite: 148]
      clk <= '1';
      wait for CLK_PERIOD_NS/2; [cite: 148]
    end loop;
    wait;
  end process; [cite: 148]

  ------------------------------------------------------------------
  -- ???????? ?? ??????
  ------------------------------------------------------------------
  stim_proc: process
  begin
    -- ????????? ????????
    rst_n <= '0'; [cite: 149]
    wait for 200 ns; [cite: 150]
    rst_n <= '1';
    wait for 200 ns; [cite: 150]

    -- ???? 1: ????? ?????? ????? (write)
    addr <= "0101010"; [cite: 151]
    rw <= '0'; -- ????? [cite: 152]
    data_in <= x"5A"; [cite: 152]
    wait for CLK_PERIOD_NS; [cite: 153]
    start <= '1'; [cite: 153]
    wait for CLK_PERIOD_NS; [cite: 154]
    start <= '0';

    -- ?????? ?? ?????????? ??????????
    wait until busy = '1'; [cite: 154]
    wait until busy = '0'; [cite: 155]
    report "Write transaction finished, continuing to read test"; [cite: 155]
    wait for 1 us; [cite: 155]

    -- ???? 2: ??????? ?????? ????? (read)
    addr <= "0101010"; [cite: 156]
    rw <= '1'; -- ??????? [cite: 156]
    data_in <= (others => '0'); [cite: 157]

    -- ??????????? slave-????????
    slave_byte <= x"A5"; [cite: 159]
    -- slave_bit_idx <= 7; -- *** ???????? ?????? (Fix 2) *** 
    wait for 200 ns; [cite: 159]
    slave_active <= '1';

    wait for CLK_PERIOD_NS; [cite: 159]
    start <= '1'; [cite: 160]
    wait for CLK_PERIOD_NS; [cite: 160]
    start <= '0';

    -- ?????????? ?????????? ????????
    wait until busy = '1'; [cite: 160]
    wait until busy = '0'; [cite: 161]
    wait for 500 ns; -- ???????? ????? 

    -- *** ??????? (Fix 1) ***
    -- ????????? ?????? (report "Read transaction...") ????????? ??????? 
    report "Read transaction finished, check data_out in waveform"; 
    
    tb_done <= '1'; [cite: 162]

    wait;
  end process;

  ------------------------------------------------------------------
  -- ??????? slave-???????? ??? ????????? Rx
  ------------------------------------------------------------------
  slave_proc: process
  begin
    wait until slave_active = '1'; [cite: 164]
    
    -- *** ?????? ???? (Fix 2) ***
    slave_bit_idx <= 7; -- ????????????? ??????????
    
    -- ?????? ??????? ?????? SCL
    wait until scl = '0'; [cite: 165]
    wait for 1 ns; [cite: 165]

    -- ?????????????? ???? ??? ??????? ??????? SCL
    while slave_active = '1' loop [cite: 166]
      wait until scl = '0'; [cite: 166]
      -- ?????????? ??? ??? ??????????? ??????????
      sda_tb <= slave_byte(slave_bit_idx); [cite: 167]
      wait until scl = '1'; -- master ?????? ?? ??????? [cite: 168]
      
      if slave_bit_idx = 0 then
        -- ????????? ???????? 8 ?????
        slave_active <= '0'; [cite: 168]
        sda_tb <= 'Z'; [cite: 169]
        exit;
      else
        slave_bit_idx <= slave_bit_idx - 1; [cite: 169]
        -- ?? ??????? ?????????? ????????? ???
        wait until scl = '0'; [cite: 170]
      end if;
    end loop; [cite: 171]
    wait;
  end process;

  ------------------------------------------------------------------
  -- ?????????? ?????????
  ------------------------------------------------------------------
  finish_proc: process
  begin
    wait until tb_done = '1'; [cite: 173]
    wait for 1 us; [cite: 174]
    report "Testbench finished"; [cite: 174]
    wait;
  end process;

end architecture;
